# Build & dependency directories
node_modules/
dist/
dist-standalone/
.dart_tool/
.pub-cache/
build/
*.DS_Store
*.apk
*.exe

# IDE / Editor config
.vscode/
.idea/
*.iml

# Environment
.env.local

# Flutter platform — generated files (do NOT commit these)
flutter_optical_transfer/android/local.properties
flutter_optical_transfer/ios/Flutter/Generated.xcconfig
flutter_optical_transfer/ios/Flutter/flutter_export_environment.sh
flutter_optical_transfer/macos/Flutter/Flutter-Generated.xcconfig
flutter_optical_transfer/macos/Flutter/flutter_export_environment.sh
flutter_optical_transfer/macos/Flutter/ephemeral/
flutter_optical_transfer/ios/Pods/
flutter_optical_transfer/macos/Pods/

# Keep .gitkeep files
!.gitkeep

# Explicitly track prebuilt release binaries in released/
!released/*.apk
!released/*.exe
!released/*.zip
!released/**
